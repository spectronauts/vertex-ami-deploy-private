# ================================================================================================
#  VerteX system console and tenant settings, applied after the cluster is up
#
#  Copy this file to system.env (keep it private: chmod 600 system.env). The deployment itself
#  comes from config.env. Only the SYSTEM ADMIN block is required; leave a setting empty to keep
#  what VerteX already has. Certificate and key settings take paths to PEM files. A password
#  left empty is asked for at run time; nothing in this file is written to the run logs.
# ================================================================================================


# ------------------------------------------------------------------------------------------------
#  SYSTEM ADMIN (required)
# ------------------------------------------------------------------------------------------------

# The system console user. A new install has one: admin.
SYSTEM_ADMIN_USERNAME="admin"

# Its current password. A new install's is admin, which must be changed on first login.
SYSTEM_ADMIN_PASSWORD="admin"

# The new password, set on first login. Empty: asked for at run time.
SYSTEM_ADMIN_NEW_PASSWORD=""

# The admin's email address, set on first login (password recovery, notifications).
SYSTEM_ADMIN_EMAIL=""


# ------------------------------------------------------------------------------------------------
#  ACTIVATION
# ------------------------------------------------------------------------------------------------

# Activation key from Spectro Cloud support for this install's product ID. Empty: stay in the
# 30-day trial (the system console shows the product ID under Administration > Activation).
ACTIVATION_KEY=""


# ------------------------------------------------------------------------------------------------
#  DOMAIN AND TLS CERTIFICATE (Administration > System Address)
# ------------------------------------------------------------------------------------------------

# Fully qualified name users reach VerteX at, for example vertex.example.com. It must resolve to
# the VIP (NLB_PRIVATE_IP in config.env). Empty: keep using the VIP's address.
DOMAIN_HOST=""

# Server certificate for DOMAIN_HOST (PEM). Empty: keep the self-signed certificate.
TLS_CERT_FILE=""

# Its private key (PEM, unencrypted).
TLS_KEY_FILE=""

# The CA certificate that issued it, with any intermediates (PEM).
TLS_CA_CERT_FILE=""

# Skip verifying the certificate chain: true or false.
TLS_INSECURE_SKIP_VERIFY="false"


# ------------------------------------------------------------------------------------------------
#  SMTP (Administration > SMTP): email for tenant activation, password resets and alerts
# ------------------------------------------------------------------------------------------------

# Mail server host name or IP. Empty: no SMTP.
SMTP_SERVER=""

# Mail server port.
SMTP_PORT="587"

# Sender address on every email.
SMTP_FROM=""

# Mail server user name; empty for no authentication.
SMTP_USERNAME=""

# Mail server password. Empty with SMTP_USERNAME set: asked for at run time.
SMTP_PASSWORD=""

# Skip verifying the mail server's TLS certificate: true or false.
SMTP_INSECURE_SKIP_VERIFY="false"


# ------------------------------------------------------------------------------------------------
#  OUTBOUND PROXY
# ------------------------------------------------------------------------------------------------

# Proxy for HTTP traffic, for example http://proxy.example.com:3128. Empty: no proxy.
SYSTEM_HTTP_PROXY=""

# Proxy for HTTPS traffic.
SYSTEM_HTTPS_PROXY=""

# Comma-separated hosts, domains and CIDRs that bypass the proxy.
SYSTEM_NO_PROXY=""


# ------------------------------------------------------------------------------------------------
#  REVERSE PROXY (Spectro Proxy, for reaching workload clusters' APIs through VerteX)
# ------------------------------------------------------------------------------------------------

# The reverse proxy server's host name or IP. Empty: no reverse proxy.
REVERSE_PROXY_SERVER=""

# Its port.
REVERSE_PROXY_PORT="443"

# http or https.
REVERSE_PROXY_PROTOCOL="https"

# The port clusters use for the reverse proxy's virtual hosts.
REVERSE_PROXY_VHOST_PORT="443"

# CA certificate for the reverse proxy (PEM).
REVERSE_PROXY_CA_CERT_FILE=""

# Client certificate VerteX presents to the reverse proxy (PEM).
REVERSE_PROXY_CLIENT_CERT_FILE=""

# Its private key (PEM, unencrypted).
REVERSE_PROXY_CLIENT_KEY_FILE=""


# ------------------------------------------------------------------------------------------------
#  BANNERS (Administration > Banner)
# ------------------------------------------------------------------------------------------------

# Show a login banner (terms users accept before signing in) on the system console:
# true or false.
LOGIN_BANNER_ENABLED="false"

# Its title.
LOGIN_BANNER_TITLE=""

# Its message.
LOGIN_BANNER_MESSAGE=""

# Classification banner across every page, as the JSON the console saves. To get it, set the
# banner once in the console, then save the "config" value that
# GET /v1/system/classificationBanner returns to a file. Empty: no change.
CLASSIFICATION_BANNER_CONFIG_FILE=""


# ------------------------------------------------------------------------------------------------
#  SYSTEM SECURITY
# ------------------------------------------------------------------------------------------------

# Minutes before a system console session expires.
SYSTEM_SESSION_MINUTES=""

# Password rules for system console users. Empty: keep the current value.
SYSTEM_PASSWORD_MIN_LENGTH=""
SYSTEM_PASSWORD_MAX_LENGTH=""
SYSTEM_PASSWORD_MIN_UPPERCASE=""
SYSTEM_PASSWORD_MIN_LOWERCASE=""
SYSTEM_PASSWORD_MIN_DIGITS=""
SYSTEM_PASSWORD_MIN_SPECIAL=""

# A regular expression passwords must match, instead of the counts above.
SYSTEM_PASSWORD_REGEX=""

# Days before a password expires, days before expiry to start reminding, and days between
# reminders.
SYSTEM_PASSWORD_EXPIRY_DAYS=""
SYSTEM_PASSWORD_FIRST_REMINDER_DAYS=""
SYSTEM_PASSWORD_REMINDER_FREQUENCY_DAYS=""

# File of passwords nobody may use, one per line.
PASSWORD_BLOCKLIST_FILE=""


# ------------------------------------------------------------------------------------------------
#  MORE SYSTEM ADMINS
# ------------------------------------------------------------------------------------------------

# One line each: "<role> <email> <first name> <last name>". Role: AccountAdmin (root
# administrator) or OperationAdmin (operations administrator). Each gets a password link.
SYSTEM_ADMINS=(
)


# ------------------------------------------------------------------------------------------------
#  DATABASE BACKUPS
# ------------------------------------------------------------------------------------------------

# Where scheduled backups go: s3, ftp, or empty for none.
BACKUP_TARGET=""

# The schedule, as the console's Backup settings: how often, the hour of day (0-23) it runs,
# and how long backups are kept.
BACKUP_INTERVAL=""
BACKUP_HOUR_OF_DAY=""
BACKUP_RETENTION=""

# BACKUP_TARGET=s3: bucket, its region, a folder in it, and an access key that can write to it.
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_FOLDER=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""

# BACKUP_TARGET=ftp: server, directory, and credentials.
BACKUP_FTP_SERVER=""
BACKUP_FTP_DIR=""
BACKUP_FTP_USERNAME=""
BACKUP_FTP_PASSWORD=""


# ------------------------------------------------------------------------------------------------
#  TENANT (Tenant Management): created and activated if TENANT_ORG_NAME is set
# ------------------------------------------------------------------------------------------------

# The organization name users sign in to. Empty: no tenant.
TENANT_ORG_NAME=""

# The tenant's first admin user.
TENANT_ADMIN_EMAIL=""
TENANT_ADMIN_FIRST_NAME=""
TENANT_ADMIN_LAST_NAME=""

# That admin's password. Empty: print the tenant's activation link for the admin instead.
TENANT_ADMIN_PASSWORD=""

# The tenant console's starting view: devops (clusters and profiles) or dev (app workspaces).
TENANT_LOGIN_MODE="devops"


# ------------------------------------------------------------------------------------------------
#  TENANT FIPS (Tenant Settings > Platform Settings)
# ------------------------------------------------------------------------------------------------

# Allow packs that are not FIPS-compliant: true or false.
TENANT_ALLOW_NON_FIPS_PACKS="false"

# Allow importing clusters that are not FIPS-compliant: true or false.
TENANT_ALLOW_NON_FIPS_CLUSTER_IMPORT="false"

# Allow cluster features that are not FIPS-compliant: true or false.
TENANT_ALLOW_NON_FIPS_CLUSTER_FEATURES="false"


# ------------------------------------------------------------------------------------------------
#  TENANT SECURITY
# ------------------------------------------------------------------------------------------------

# Minutes before a tenant session expires.
TENANT_SESSION_MINUTES=""

# Password rules for tenant users. Empty: keep the current value.
TENANT_PASSWORD_MIN_LENGTH=""
TENANT_PASSWORD_MAX_LENGTH=""
TENANT_PASSWORD_MIN_UPPERCASE=""
TENANT_PASSWORD_MIN_LOWERCASE=""
TENANT_PASSWORD_MIN_DIGITS=""
TENANT_PASSWORD_MIN_SPECIAL=""
TENANT_PASSWORD_REGEX=""
TENANT_PASSWORD_EXPIRY_DAYS=""
TENANT_PASSWORD_FIRST_REMINDER_DAYS=""

# Login banner on the tenant's sign-in page: true or false, then its title and message.
TENANT_LOGIN_BANNER_ENABLED="false"
TENANT_LOGIN_BANNER_TITLE=""
TENANT_LOGIN_BANNER_MESSAGE=""

# Certificates to add to the tenant, for example the CA of a private registry or identity
# provider. One line each: "<name> <certificate.pem>".
TENANT_CA_CERTS=(
)


# ------------------------------------------------------------------------------------------------
#  TENANT SINGLE SIGN-ON
# ------------------------------------------------------------------------------------------------

# oidc, saml, or empty for none (users sign in with passwords).
TENANT_SSO=""

# Teams every SSO user joins, and whether to copy the identity provider's teams: true or false.
TENANT_SSO_DEFAULT_TEAMS=""
TENANT_SSO_SYNC_TEAMS="false"

# TENANT_SSO=oidc: the identity provider's issuer URL, and this tenant's client there.
TENANT_OIDC_ISSUER_URL=""
TENANT_OIDC_CLIENT_ID=""
TENANT_OIDC_CLIENT_SECRET=""

# Space-separated scopes to request.
TENANT_OIDC_SCOPES="openid profile email"

# The issuer's CA certificate (PEM), and whether to skip verifying it: true or false.
TENANT_OIDC_CA_CERT_FILE=""
TENANT_OIDC_INSECURE_SKIP_VERIFY="false"

# Claims that hold each user's email, first name, last name and teams.
TENANT_OIDC_CLAIM_EMAIL="email"
TENANT_OIDC_CLAIM_FIRST_NAME="given_name"
TENANT_OIDC_CLAIM_LAST_NAME="family_name"
TENANT_OIDC_CLAIM_TEAMS="groups"

# Read the claims from the userinfo endpoint instead of the ID token: true or false.
TENANT_OIDC_USE_USERINFO="false"

# Where to send users after they sign out.
TENANT_OIDC_LOGOUT_URL=""

# TENANT_SSO=saml: the identity provider's federation metadata (XML file), its name, the NameID
# format, and whether signing out of VerteX signs out of the identity provider: true or false.
TENANT_SAML_METADATA_FILE=""
TENANT_SAML_IDENTITY_PROVIDER=""
TENANT_SAML_NAME_ID_FORMAT=""
TENANT_SAML_SINGLE_LOGOUT="false"
