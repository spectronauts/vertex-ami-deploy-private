# Secrets and per-deployment settings: copy the .example files and fill them in.
config.env
system.env
user-data.yaml
.fusion-password
*.bak

# Cluster-admin credentials written by ./connect.sh kubeconfig.
kubeconfig-*

# Written by deploy.sh: this deployment's resource IDs.
outputs-*.txt

# Run logs written by every script.
logs/

# Working drafts, not part of the tooling.
bug-*.md

.DS_Store

# Certificates and keys for system.env (TLS, reverse proxy, identity providers).
certs/

# Terraform: settings, state and provider cache (the lock file is kept).
terraform/terraform.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/crash.log
