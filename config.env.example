# Settings for the ami-deploy-private scripts: the VerteX appliance on AWS with no public
# subnets. Copy to config.env and set the six values in the first block. Also copy
# user-data.yaml.example to user-data.yaml and set the password and your SSH public key.
# Every script checks these settings first and names any it can't use.

# --- Set these --------------------------------------------------------------------------------
REGION="us-gov-west-1"            # AWS region
NAME_PREFIX="vxp"                 # Names and tags every resource; unique per deployment
                                  # (letters, digits and dashes, up to 20 characters)
AMI_ID=""                         # The VerteX appliance AMI in REGION
KEY_NAME=""                       # EC2 key pair; the AMI installs it for the kairos user
SSH_KEY_FILE=""                   # KEY_NAME's private key (.pem), for ./connect.sh and
                                  # ./status.sh --watch; ~ is fine
NLB_PRIVATE_IP="10.0.11.210"      # The VIP: a free address in PRIVATE_CIDR. Enter it in Local UI
                                  # before the NLB exists (INSTALL.md Step 8)

# --- Optional: the defaults are shown; uncomment a line to change it --------------------------
# ACCESS_METHOD="eice"            # eice: EC2 Instance Connect Endpoint (SSH only; no hourly cost)
#                                 # ssm:  jump host and SSM endpoints (billed hourly); needs
#                                 #       session-manager-plugin on your workstation
# APP_COUNT=3                     # Nodes: 3 for a cluster, 1 for a single node
# INSTANCE_TYPE="m5.2xlarge"      # 8 vCPU, 32 GiB
# ROOT_VOLUME_SIZE_GB=300         # At least 300 (INSTALL.md Step 5)
# DATA_VOLUME_SIZE_GB=500         # The one data disk the AMI builds its storage pool on
# USER_DATA_FILE="user-data.yaml"
# AZ=""                           # Empty: the first zone that offers INSTANCE_TYPE
# VPC_CIDR="10.0.0.0/16"
# PRIVATE_CIDR="10.0.11.0/24"     # The only subnet: nodes, NLB and access endpoint
# LOCALUI_USER=""                 # ./connect.sh link signs in as this user; empty: the first
#                                 # user in USER_DATA_FILE, with its password
# SSH_USER="kairos"               # The user ./connect.sh signs in to the nodes as
# JUMP_INSTANCE_TYPE="t3.micro"   # ACCESS_METHOD=ssm only
# LOG_DIR="logs"                  # Where each run's log goes
