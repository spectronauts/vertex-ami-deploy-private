# ami-deploy-private settings: the VerteX appliance on AWS with NO public subnets.
# Nothing in the VPC is reachable from, or can reach, the internet. You get in through
# AWS's own services, chosen by ACCESS_METHOD. Copy to config.env and fill in REQUIRED.

# --- Network -------------------------------------------------------------
REGION="us-gov-west-1"                    # REQUIRED
AZ=""                                     # Empty = first zone offering the instance types
NAME_PREFIX="vxp"                         # Name and tag prefix for every resource
VPC_CIDR="10.0.0.0/16"
PRIVATE_CIDR="10.0.11.0/24"               # The only subnet: nodes, NLB and access endpoints
APP_PORTS="443 6443 30003 5080"
APP_COUNT=3                               # 1 for single-node, 3 for a cluster

# --- Access (pick one per deployment) -------------------------------------
# eice: an EC2 Instance Connect Endpoint. No instance, no IAM role, no hourly charge.
#       Tunnels SSH only; Local UI is reached with ssh -L through a node (./connect.sh).
# ssm:  a small Amazon Linux jump host (no inbound ports) with an SSM role, plus the ssm,
#       ssmmessages and ec2messages interface endpoints (billed hourly). Port-forwards
#       any node port to your workstation (./connect.sh). Needs session-manager-plugin locally.
ACCESS_METHOD="eice"
JUMP_INSTANCE_TYPE="t3.micro"             # ssm only
SSH_KEY_FILE=""                           # Path to KEY_NAME's private key (.pem), for ./connect.sh
SSH_USER="kairos"                         # The AMI installs your EC2 key pair for kairos; or your user-data user

# --- Load balancer and VIP -------------------------------------------------
NLB_PRIVATE_IP="10.0.11.210"              # The VIP: a free IP in PRIVATE_CIDR. Create the NLB on it
                                          # AFTER Deploy Cluster (Local UI refuses an IP a device owns)
PRESERVE_CLIENT_IP="false"                # Off, so a node can reach its own API through the VIP
NODE_TO_NODE="true"                       # Nodes talk directly (linking, etcd, kubelet, CNI, DRBD)

# --- Appliance nodes -------------------------------------------------------
AMI_ID=""                                 # REQUIRED: the VerteX appliance AMI
INSTANCE_TYPE="m5.2xlarge"
KEY_NAME=""                               # REQUIRED: EC2 key pair (SSH to the nodes)
ROOT_VOLUME_SIZE_GB=300                   # At least 300: below 40 the node stays in recovery; too small and kubelet garbage-collects preloaded images (INSTALL.md Step 4)
DATA_VOLUME_COUNT=1                       # The AMI builds its storage pool on one unused disk
DATA_VOLUME_SIZE_GB=500
USER_DATA_FILE="user-data.yaml"           # Copy user-data.yaml.example; set the password and SSH key
