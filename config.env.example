# ================================================================================================
#  ami-deploy-private settings: the VerteX appliance on AWS, private subnets only
#
#  Copy this file to config.env and set the six values under REQUIRED. Everything under
#  OPTIONAL already has a working value. Every script checks these settings before it starts.
# ================================================================================================


# ------------------------------------------------------------------------------------------------
#  REQUIRED
# ------------------------------------------------------------------------------------------------

# AWS region to deploy in.
REGION="us-gov-west-1"

# Prefix for every resource's name and tag; unique per deployment (up to 20 letters, digits, -).
NAME_PREFIX="vxp"

# The VerteX appliance AMI in REGION.
AMI_ID=""

# EC2 key pair; the AMI installs it for the kairos user.
KEY_NAME=""

# KEY_NAME's private key (.pem), for ./connect.sh and ./status.sh --watch; ~ is fine.
SSH_KEY_FILE=""

# The cluster VIP: a free address in PRIVATE_CIDR. Enter it in Local UI before the NLB exists.
NLB_PRIVATE_IP="10.0.11.210"


# ------------------------------------------------------------------------------------------------
#  OPTIONAL: nodes
# ------------------------------------------------------------------------------------------------

# Number of nodes: 3 for a cluster, 1 for a single node.
APP_COUNT="3"

# Node instance type (8 vCPU, 32 GiB).
INSTANCE_TYPE="m5.2xlarge"

# Root volume in GB; at least 300 (INSTALL.md Step 5).
ROOT_VOLUME_SIZE_GB="300"

# Data volume in GB; the AMI builds its storage pool on it.
DATA_VOLUME_SIZE_GB="500"

# Node user data: copy user-data.yaml.example, then set the password and your SSH public key.
USER_DATA_FILE="user-data.yaml"


# ------------------------------------------------------------------------------------------------
#  OPTIONAL: network
# ------------------------------------------------------------------------------------------------

# Availability zone; empty picks the first zone that offers INSTANCE_TYPE.
AZ=""

# VPC address range.
VPC_CIDR="10.0.0.0/16"

# The only subnet: nodes, NLB and access endpoint.
PRIVATE_CIDR="10.0.11.0/24"


# ------------------------------------------------------------------------------------------------
#  OPTIONAL: access
# ------------------------------------------------------------------------------------------------

# eice: EC2 Instance Connect Endpoint (no hourly cost). ssm: jump host and SSM endpoints (billed
# hourly; needs session-manager-plugin on your workstation).
ACCESS_METHOD="eice"

# Jump host instance type (ACCESS_METHOD=ssm only).
JUMP_INSTANCE_TYPE="t3.micro"

# User ./connect.sh signs in to the nodes as.
SSH_USER="kairos"

# Local UI user for ./connect.sh link; empty uses the first user in USER_DATA_FILE.
LOCALUI_USER=""


# ------------------------------------------------------------------------------------------------
#  OPTIONAL: logs
# ------------------------------------------------------------------------------------------------

# Where each run's log goes.
LOG_DIR="logs"
